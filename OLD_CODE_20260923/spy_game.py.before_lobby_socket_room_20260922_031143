def create_spy_game(
    game_id,
    players,
    host,
    discussion_seconds=120
):
    room = spy_engine.create_room(
        game_id,
        players,
        host
    )

    room.discussion_seconds = max(
        MIN_DISCUSSION_SECONDS,
        min(
            MAX_DISCUSSION_SECONDS,
            int(discussion_seconds)
        )
    )

    return room


